/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"ai": {
		"binding": "AI",
	},
	"d1_databases": [{
    "binding": "DB",
    "database_id": "eeec824c-799b-47e2-a2f8-7bd265620b0c",
    "remote": true
  }],
	"kv_namespaces": [{
		"binding": "CACHE",
		"id": "553cbda00f204c32a1f6faaaa1bf32db",
		"remote": true
	}],
	"queues": {
		"consumers": [{
			"queue": "smart-links-data-queue-stage",
			"dead_letter_queue": "smart-links-data-dead-letter-stage"
		}, {
			"queue": "smart-links-data-dead-letter-stage",
			"retry_delay": 0
		}],
		"producers": [{
			"binding": "QUEUE",
			"queue": "smart-links-data-queue-stage"
		}],
	},
	"r2_buckets": [{
		"binding": "BUCKET",
		"bucket_name": "smart-links-eval-stage"
	}],
	"workflows": [{
		"binding": "DESTINATION_EVALUATION_WORKFLOW",
		"name": "destination-evaluation-workflow",
		"class_name": "DestinationEvaluationWorkflow",
	}],
	"browser": {
		"binding": "VIRTUAL_BROWSER"
	}
}
